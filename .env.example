# OpenHive Configuration
# Copy this file to .env.local and fill in your values
# Or use the setup wizard at http://localhost:3000/setup

# ---- Supabase (required) ----
# Get these from: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ---- Supabase service_role key (optional, but recommended) ----
# Needed for: email invitations, and file uploads when STORAGE_PROVIDER=supabase
# Get from: Supabase Dashboard > Settings > API > service_role secret
# WARNING: this key bypasses Row Level Security. Server-side only — never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- LiveKit (optional — for video/audio calls) ----
# Get these from: cloud.livekit.io or your self-hosted LiveKit server
# Note: LiveKit credentials are configured per-workspace in the admin settings UI,
# not here. These env vars are only needed if you want a global default.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-api-key
# LIVEKIT_API_SECRET=your-api-secret

# ============================================================
# 文件存储后端
# ============================================================
# supabase(默认)= Supabase Storage,免费层 1 GB 存储 + 5 GB 出口/月
# s3            = 任意 S3 兼容对象存储,推荐 Cloudflare R2
#                 (免费层 10 GB 存储 + 零出口流量费)
#
# 切换到 s3 后,SUPABASE_SERVICE_ROLE_KEY 就不再需要了 ——
# 它只是 Supabase Storage 的写入凭证。
# STORAGE_PROVIDER=supabase

# ---- S3 兼容存储配置(仅当 STORAGE_PROVIDER=s3 时需要) ----
# 以 Cloudflare R2 为例:
#   1. Cloudflare 控制台 > R2 > 创建存储桶,例如 openhive
#   2. 在该桶的设置里开启「公开访问」,或绑定自定义域名
#   3. R2 > Manage API Tokens > 创建令牌(权限选 Object Read & Write)
#   4. 在下方填入 endpoint / 密钥 / 桶名
#
# 其他可用后端:Backblaze B2、MinIO、AWS S3、阿里云 OSS(S3 兼容模式)
# S3_ENDPOINT=https://<你的账号ID>.r2.cloudflarestorage.com
# S3_BUCKET=openhive
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_REGION=auto
# S3_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
#   ↑ 公开访问前缀,用于拼接图片最终 URL。
#     填 R2 桶的公开开发域名,或你绑定的自定义域名。
#     留空则回退为 <S3_ENDPOINT>/<S3_BUCKET>,这要求桶允许公开读取。
